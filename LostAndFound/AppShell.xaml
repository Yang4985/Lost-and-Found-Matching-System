<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="LostAndFound.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:sf="clr-namespace:Syncfusion.Maui.Toolkit.SegmentedControl;assembly=Syncfusion.Maui.Toolkit"
    xmlns:pages="clr-namespace:LostAndFound.Pages"
    Shell.FlyoutBehavior="Flyout"
    Title="LostAndFound">

    <ShellContent
    Title="Home"
    Icon="{StaticResource IconDashboard}"
    ContentTemplate="{DataTemplate pages:WelcomePage}"
    Route="home" />

    <ShellContent
    Title="Report Lost Item"
    Icon="{StaticResource IconDashboard}"
    ContentTemplate="{DataTemplate pages:LostReportPage}"
    Route="lost-reports" />

    <ShellContent
    Title="Report Found Item"
    ContentTemplate="{DataTemplate pages:PublicFoundReportPage}"
    Route="public-found-report"
    FlyoutItemIsVisible="False" />

    <ShellContent
    Title="Staff Sign In"
    ContentTemplate="{DataTemplate pages:StaffLoginPage}"
    Route="staff-login"
    FlyoutItemIsVisible="False" />

    <ShellContent
    Title="Staff Dashboard"
    ContentTemplate="{DataTemplate pages:StaffDashboardPage}"
    Route="staff-dashboard"
    FlyoutItemIsVisible="False" />

    <ShellContent
    Title="Found Reports"
    Icon="{StaticResource IconProjects}"
    ContentTemplate="{DataTemplate pages:FoundReportPage}"
    Route="found-reports"
    FlyoutItemIsVisible="False" />

    <ShellContent
    Title="Possible Matches"
    Icon="{StaticResource IconMeta}"
    ContentTemplate="{DataTemplate pages:MatchesPage}"
    Route="matches"
    FlyoutItemIsVisible="False" />

    <Shell.FlyoutFooter>
        <Grid Padding="15">
            <sf:SfSegmentedControl x:Name="ThemeSegmentedControl" 
                VerticalOptions="Center" HorizontalOptions="Center" SelectionChanged="SfSegmentedControl_SelectionChanged"
                SegmentWidth="40" SegmentHeight="40">
                <sf:SfSegmentedControl.ItemsSource>
                    <x:Array Type="{x:Type sf:SfSegmentItem}">
                        <sf:SfSegmentItem ImageSource="{StaticResource IconLight}" SemanticProperties.Description="Light mode"/>
                        <sf:SfSegmentItem ImageSource="{StaticResource IconDark}" SemanticProperties.Description="Dark mode"/>
                    </x:Array>
                </sf:SfSegmentedControl.ItemsSource>
            </sf:SfSegmentedControl>
        </Grid>
    </Shell.FlyoutFooter>

</Shell>
