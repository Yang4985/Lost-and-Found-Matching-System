<?xml version="1.0" encoding="utf-8" ?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LostAndFound.Pages.WelcomePage"
             Title="Home"
             BackgroundColor="#151517">

    <ScrollView>

        <Grid Padding="40"
              MaximumWidthRequest="1200"
              HorizontalOptions="Center"
              ColumnDefinitions="2*,*"
              ColumnSpacing="28">

            <!-- LEFT SIDE -->
            <VerticalStackLayout
                Grid.Column="0"
                Spacing="32"
                VerticalOptions="Center">

                <!-- HEADER -->
                <VerticalStackLayout
                    Spacing="8"
                    HorizontalOptions="Center">

                    <Label
                        Text="CampusFind"
                        FontSize="42"
                        FontAttributes="Bold"
                        TextColor="#B69CFF"
                        HorizontalTextAlignment="Center" />

                    <Label
                        Text="University Lost &amp; Found"
                        FontSize="22"
                        FontAttributes="Bold"
                        TextColor="White"
                        HorizontalTextAlignment="Center" />

                    <Label
                        Text="Report lost or found property and help items get back to their owners."
                        FontSize="15"
                        TextColor="#A9A9B2"
                        HorizontalTextAlignment="Center"
                        MaximumWidthRequest="650" />

                </VerticalStackLayout>


                <!-- MAIN OPTIONS -->
                <Grid ColumnDefinitions="*,*"
                      ColumnSpacing="20">

                    <!-- LOST ITEM -->
                    <Border Grid.Column="0"
                            Padding="28"
                            BackgroundColor="#1D1D21"
                            Stroke="#33333A"
                            StrokeShape="RoundRectangle 18">

                        <VerticalStackLayout Spacing="15">

                            <Label
                                Text="?"
                                FontSize="35"
                                TextColor="#B69CFF" />

                            <Label
                                Text="Lost Something?"
                                FontSize="22"
                                FontAttributes="Bold"
                                TextColor="White" />

                            <Label
                                Text="Create a lost-item report so campus staff can help identify possible matches."
                                TextColor="#A9A9B2"
                                FontSize="14" />

                            <Button
                                Text="Report a Lost Item"
                                Clicked="OnReportLostClicked"
                                BackgroundColor="#5930DB"
                                TextColor="White"
                                FontAttributes="Bold"
                                CornerRadius="10"
                                HeightRequest="48" />

                        </VerticalStackLayout>

                    </Border>


                    <!-- FOUND ITEM -->
                    <Border Grid.Column="1"
                            Padding="28"
                            BackgroundColor="#1D1D21"
                            Stroke="#33333A"
                            StrokeShape="RoundRectangle 18">

                        <VerticalStackLayout Spacing="15">

                            <Label
                                Text="✓"
                                FontSize="35"
                                TextColor="#72D59B" />

                            <Label
                                Text="Found Something?"
                                FontSize="22"
                                FontAttributes="Bold"
                                TextColor="White" />

                            <Label
                                Text="Tell campus staff what you found and where you found it."
                                TextColor="#A9A9B2"
                                FontSize="14" />

                            <Button
                                Text="Report Found Item"
                                Clicked="OnReportFoundClicked"
                                BackgroundColor="#3E7C5C"
                                TextColor="White"
                                FontAttributes="Bold"
                                CornerRadius="10"
                                HeightRequest="48" />

                        </VerticalStackLayout>

                    </Border>

                </Grid>


                <!-- STAFF -->
                <Border
                    Padding="24"
                    BackgroundColor="#211E2C"
                    Stroke="#463A68"
                    StrokeShape="RoundRectangle 16">

                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="20">

                        <VerticalStackLayout
                            Grid.Column="0"
                            Spacing="4">

                            <Label
                                Text="Campus Staff"
                                FontSize="19"
                                FontAttributes="Bold"
                                TextColor="White" />

                            <Label
                                Text="Sign in to manage found reports, review matches, and record returned items."
                                FontSize="14"
                                TextColor="#A9A9B2" />

                        </VerticalStackLayout>

                        <Button
                            Grid.Column="1"
                            Text="Staff Sign In"
                            Clicked="OnStaffSignInClicked"
                            BackgroundColor="#5930DB"
                            TextColor="White"
                            FontAttributes="Bold"
                            CornerRadius="10"
                            Padding="22,0"
                            HeightRequest="46"
                            VerticalOptions="Center" />

                    </Grid>

                </Border>


                <Label
                    Text="Items are only released after ownership has been verified by authorised staff."
                    FontSize="12"
                    TextColor="#777780"
                    HorizontalTextAlignment="Center" />

            </VerticalStackLayout>


            <!-- RIGHT SIDE: FOUND ITEM CATEGORY SUMMARY -->
            <Border
                Grid.Column="1"
                Padding="24"
                BackgroundColor="#1D1D21"
                Stroke="#33333A"
                StrokeShape="RoundRectangle 18"
                VerticalOptions="Center">

                <VerticalStackLayout Spacing="16">

                    <Label
                        Text="Found Items"
                        FontSize="23"
                        FontAttributes="Bold"
                        TextColor="White" />

                    <Label
                        Text="Items currently reported found on campus."
                        FontSize="13"
                        TextColor="#A9A9B2" />

                    <BoxView
                        HeightRequest="1"
                        Color="#33333A" />


                    <Grid
                        ColumnDefinitions="*,Auto"
                        RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                        RowSpacing="14">

                        <Label
                            Grid.Row="0"
                            Text="Wallets"
                            TextColor="#D5D5DA" />

                        <Label
                            Grid.Row="0"
                            Grid.Column="1"
                            x:Name="WalletCountLabel"
                            Text="0"
                            FontAttributes="Bold"
                            TextColor="#B69CFF" />


                        <Label
                            Grid.Row="1"
                            Text="Electronics"
                            TextColor="#D5D5DA" />

                        <Label
                            Grid.Row="1"
                            Grid.Column="1"
                            x:Name="ElectronicsCountLabel"
                            Text="0"
                            FontAttributes="Bold"
                            TextColor="#B69CFF" />


                        <Label
                            Grid.Row="2"
                            Text="Keys"
                            TextColor="#D5D5DA" />

                        <Label
                            Grid.Row="2"
                            Grid.Column="1"
                            x:Name="KeysCountLabel"
                            Text="0"
                            FontAttributes="Bold"
                            TextColor="#B69CFF" />


                        <Label
                            Grid.Row="3"
                            Text="Clothing"
                            TextColor="#D5D5DA" />

                        <Label
                            Grid.Row="3"
                            Grid.Column="1"
                            x:Name="ClothingCountLabel"
                            Text="0"
                            FontAttributes="Bold"
                            TextColor="#B69CFF" />


                        <Label
                            Grid.Row="4"
                            Text="Bags"
                            TextColor="#D5D5DA" />

                        <Label
                            Grid.Row="4"
                            Grid.Column="1"
                            x:Name="BagCountLabel"
                            Text="0"
                            FontAttributes="Bold"
                            TextColor="#B69CFF" />


                        <Label
                            Grid.Row="5"
                            Text="Other"
                            TextColor="#D5D5DA" />

                        <Label
                            Grid.Row="5"
                            Grid.Column="1"
                            x:Name="OtherCountLabel"
                            Text="0"
                            FontAttributes="Bold"
                            TextColor="#B69CFF" />

                    </Grid>


                    <BoxView
                        HeightRequest="1"
                        Color="#33333A" />


                    <Label
                        Text="Only general category totals are shown to protect identifying item details."
                        FontSize="12"
                        TextColor="#777780"
                        LineBreakMode="WordWrap" />

                </VerticalStackLayout>

            </Border>

        </Grid>

    </ScrollView>

</ContentPage>