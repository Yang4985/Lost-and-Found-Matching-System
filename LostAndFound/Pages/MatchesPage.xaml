<?xml version="1.0" encoding="utf-8" ?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LostAndFound.Pages.MatchesPage"
             Title="Matches"
             BackgroundColor="#151517">

    <Grid Padding="32"
          RowDefinitions="Auto,Auto,*"
          RowSpacing="22"
          MaximumWidthRequest="1100"
          HorizontalOptions="Fill">

       


        <!-- PAGE HEADER -->
        <Grid Grid.Row="0"
              ColumnDefinitions="*,Auto"
              ColumnSpacing="20">

            <VerticalStackLayout Grid.Column="0"
                                 Spacing="4">

                <Label
                    Text="Possible Matches"
                    FontSize="32"
                    FontAttributes="Bold"
                    TextColor="#B69CFF" />

                <Label
                    Text="Review suggested lost and found item pairs before confirming ownership."
                    FontSize="15"
                    TextColor="#A9A9B2" />

                <Label
                    x:Name="MatchCountLabel"
                    Text="0 possible matches"
                    FontSize="13"
                    TextColor="#777780"
                    Margin="0,4,0,0" />

            </VerticalStackLayout>


            <Button Grid.Column="1"
                    Text="Refresh Matches"
                    Clicked="OnRefreshClicked"
                    BackgroundColor="#5930DB"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="10"
                    HeightRequest="46"
                    Padding="20,0"
                    VerticalOptions="Center" />

        </Grid>


        <!-- INFORMATION BANNER -->
        <Border Grid.Row="1"
        Padding="16"
        BackgroundColor="#211E2C"
        Stroke="#463A68"
        StrokeThickness="1"
        StrokeShape="RoundRectangle 12">

            <Grid ColumnDefinitions="Auto,*"
                  ColumnSpacing="12">

                <Label Grid.Column="0"
                       Text="ⓘ"
                       FontSize="20"
                       TextColor="#B69CFF"
                       VerticalOptions="Center" />

                <Label Grid.Column="1"
                       Text="Match scores are recommendations only. Staff must verify ownership before an item is released."
                       FontSize="14"
                       TextColor="#D0C8E8"
                       VerticalOptions="Center" />

            </Grid>

        </Border>


        <!-- MATCH RESULTS -->
        <CollectionView Grid.Row="2"
                        x:Name="MatchesView">

            <CollectionView.EmptyView>

                <Border Padding="36"
                        Margin="0,12"
                        BackgroundColor="#1D1D21"
                        Stroke="#33333A"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 16">

                    <VerticalStackLayout
                        HorizontalOptions="Center"
                        Spacing="8">

                        <Label
                            Text="No Possible Matches"
                            FontSize="20"
                            FontAttributes="Bold"
                            TextColor="White"
                            HorizontalTextAlignment="Center" />

                        <Label
                            Text="Add compatible lost and found reports, then refresh the results."
                            FontSize="14"
                            TextColor="#A9A9B2"
                            HorizontalTextAlignment="Center" />

                    </VerticalStackLayout>

                </Border>

            </CollectionView.EmptyView>


            <CollectionView.ItemTemplate>

                <DataTemplate>

                    <Border Margin="0,7"
                            Padding="22"
                            BackgroundColor="#1D1D21"
                            Stroke="#33333A"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 16">

                        <VerticalStackLayout Spacing="18">


                            <!-- MATCH HEADER -->
                            <Grid ColumnDefinitions="*,Auto"
                                  ColumnSpacing="16">

                                <VerticalStackLayout
                                    Grid.Column="0"
                                    Spacing="4">

                                    <Label
                                        Text="{Binding Title}"
                                        FontSize="21"
                                        FontAttributes="Bold"
                                        TextColor="White" />

                                    <Label
                                        Text="Suggested lost ↔ found pair"
                                        FontSize="13"
                                        TextColor="#8F8F98" />

                                </VerticalStackLayout>


                                <!-- SCORE BADGE -->
                                <Border Grid.Column="1"
                                        Padding="14,8"
                                        BackgroundColor="#2C244A"
                                        Stroke="#6247A9"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 18">

                                    <Label
                                        Text="{Binding ScoreText}"
                                        FontSize="16"
                                        FontAttributes="Bold"
                                        TextColor="#C6B4FF" />

                                </Border>

                            </Grid>


                            <!-- SEPARATOR -->
                            <BoxView HeightRequest="1"
                                     Color="#33333A" />


                            <!-- MATCH EXPLANATION -->
                            <VerticalStackLayout Spacing="8">

                                <Label
                                    Text="Why this was matched"
                                    FontSize="15"
                                    FontAttributes="Bold"
                                    TextColor="#D8D8DD" />

                                <Label
                                    Text="{Binding Explanation}"
                                    FontSize="14"
                                    TextColor="#B8B8C0"
                                    LineBreakMode="WordWrap" />

                            </VerticalStackLayout>


                            <!-- STAFF REVIEW MESSAGE -->
                            <Border Padding="14"
                                    BackgroundColor="#2B241D"
                                    Stroke="#5A4630"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 10">

                                <Grid ColumnDefinitions="Auto,*"
                                      ColumnSpacing="10">

                                    <Label Grid.Column="0"
                                           Text="⚠"
                                           FontSize="18"
                                           VerticalOptions="Center" />

                                    <VerticalStackLayout
                                        Grid.Column="1"
                                        Spacing="2">

                                        <Label
                                            Text="Staff verification required"
                                            FontAttributes="Bold"
                                            FontSize="14"
                                            TextColor="#F0C27B" />

                                        <Label
                                            Text="Confirm identifying details with the claimant before returning the item."
                                            FontSize="13"
                                            TextColor="#C7AE88" />

                                    </VerticalStackLayout>

                                </Grid>

                            </Border>

                        </VerticalStackLayout>

                    </Border>

                </DataTemplate>

            </CollectionView.ItemTemplate>


            <CollectionView.Footer>

                <Grid Padding="0,28,0,20">

                    <Button
                        Text="← Back to Staff Dashboard"
                        Clicked="OnBackToDashboardClicked"
                        BackgroundColor="#5930DB"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="10"
                        HeightRequest="46"
                        Padding="24,0"
                        HorizontalOptions="Center" />

                </Grid>

            </CollectionView.Footer>

        </CollectionView>

    </Grid>

</ContentPage>


        
   
