<?xml version="1.0" encoding="utf-8" ?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             x:Class="LostAndFound.Pages.FoundReportPage"
             Title="Found Reports"
             BackgroundColor="#151517">

    <ScrollView>

        <VerticalStackLayout
            Padding="32"
            Spacing="26"
            MaximumWidthRequest="1100"
            HorizontalOptions="Fill">

            <!-- PAGE HEADER -->
            <VerticalStackLayout Spacing="4">

                <Label
                    Text="Found Reports"
                    FontSize="32"
                    FontAttributes="Bold"
                    TextColor="#B69CFF" />

                <Label
                    Text="Register found property and manage items returned to their owners."
                    FontSize="15"
                    TextColor="#A9A9B2" />

            </VerticalStackLayout>


            <!-- REGISTER FOUND ITEM CARD -->
            <Border
                Padding="24"
                BackgroundColor="#1D1D21"
                Stroke="#33333A"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 16">

                <VerticalStackLayout Spacing="18">

                    <VerticalStackLayout Spacing="3">

                        <Label
                            Text="Register a Found Item"
                            FontSize="24"
                            FontAttributes="Bold"
                            TextColor="White" />

                        <Label
                            Text="Staff can register items handed in to campus services."
                            FontSize="14"
                            TextColor="#A9A9B2" />

                    </VerticalStackLayout>


                    <!-- NAME + CATEGORY -->
                    <Grid ColumnDefinitions="*,*"
                          ColumnSpacing="16">

                        <Entry
                            Grid.Column="0"
                            x:Name="ItemNameEntry"
                            Placeholder="Item name *"
                            PlaceholderColor="#8D8D96"
                            TextColor="White" />

                        <Picker
                            Grid.Column="1"
                            x:Name="CategoryPicker"
                            Title="Category *"
                            TitleColor="#8D8D96"
                            TextColor="White" />

                    </Grid>


                    <!-- BRAND + COLOUR -->
                    <Grid ColumnDefinitions="*,*"
                          ColumnSpacing="16">

                        <Entry
                            Grid.Column="0"
                            x:Name="BrandEntry"
                            Placeholder="Brand (optional)"
                            PlaceholderColor="#8D8D96"
                            TextColor="White" />

                        <Entry
                            Grid.Column="1"
                            x:Name="ColourEntry"
                            Placeholder="Colour (optional)"
                            PlaceholderColor="#8D8D96"
                            TextColor="White" />

                    </Grid>


                    <!-- LOCATION + DATE -->
                    <Grid ColumnDefinitions="*,*"
                          ColumnSpacing="16">

                        <Entry
                            Grid.Column="0"
                            x:Name="LocationEntry"
                            Placeholder="Location found *"
                            PlaceholderColor="#8D8D96"
                            TextColor="White" />

                        <DatePicker
                            Grid.Column="1"
                            x:Name="FoundDatePicker"
                            MaximumDate="{x:Static sys:DateTime.Today}"
                            TextColor="White" />

                    </Grid>


                    <Editor
                        x:Name="DescriptionEditor"
                        Placeholder="Description *"
                        PlaceholderColor="#8D8D96"
                        TextColor="White"
                        AutoSize="TextChanges"
                        MinimumHeightRequest="100" />


                    <Entry
                        x:Name="StorageEntry"
                        Placeholder="Storage location *"
                        PlaceholderColor="#8D8D96"
                        TextColor="White" />


                    <Label
                        x:Name="ValidationLabel"
                        TextColor="#FF6B6B"
                        FontAttributes="Bold"
                        IsVisible="False" />


                    <Button
                        Text="Register Found Item"
                        Clicked="OnSaveClicked"
                        BackgroundColor="#5930DB"
                        TextColor="White"
                        FontAttributes="Bold"
                        HeightRequest="50"
                        CornerRadius="10" />

                </VerticalStackLayout>

            </Border>


            <!-- AVAILABLE FOUND ITEMS -->
            <VerticalStackLayout Spacing="12">

                <VerticalStackLayout Spacing="2">

                    <Label
                        Text="Available Found Items"
                        FontSize="24"
                        FontAttributes="Bold"
                        TextColor="White" />

                    <Label
                        Text="Select items that have been successfully returned to their owner."
                        FontSize="14"
                        TextColor="#A9A9B2" />

                </VerticalStackLayout>


                <CollectionView
                    x:Name="AvailableReportsView"
                    MinimumHeightRequest="90">

                    <CollectionView.EmptyView>

                        <Border
                            Padding="22"
                            BackgroundColor="#1D1D21"
                            Stroke="#33333A"
                            StrokeShape="RoundRectangle 14">

                            <Label
                                Text="There are currently no available found items."
                                TextColor="#A9A9B2"
                                HorizontalOptions="Center" />

                        </Border>

                    </CollectionView.EmptyView>


                    <CollectionView.ItemTemplate>

                        <DataTemplate>

                            <Border
                                Margin="0,5"
                                Padding="18"
                                BackgroundColor="#1D1D21"
                                Stroke="#33333A"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 14">

                                <Grid
                                    ColumnDefinitions="Auto,*,Auto"
                                    ColumnSpacing="16">

                                    <!-- CHECKBOX -->
                                    <CheckBox
                                        Grid.Column="0"
                                        VerticalOptions="Center"
                                        Color="#7C5CFC"
                                        CheckedChanged="OnReturnSelectionChanged" />


                                    <!-- REPORT DETAILS -->
                                    <VerticalStackLayout
                                        Grid.Column="1"
                                        Spacing="4">

                                        <Label
                                            Text="{Binding Name}"
                                            FontSize="18"
                                            FontAttributes="Bold"
                                            TextColor="White" />

                                        <Label
                                            Text="{Binding Category}"
                                            TextColor="#C6C6CE" />

                                        <Label
                                            Text="{Binding Location, StringFormat='Found at: {0}'}"
                                            TextColor="#A9A9B2" />

                                        <Label
                                            Text="{Binding StorageLocation, StringFormat='Stored at: {0}'}"
                                            TextColor="#A9A9B2" />

                                        <Label
                                            Text="{Binding DateFound, StringFormat='Found on: {0:dd MMM yyyy}'}"
                                            TextColor="#A9A9B2" />

                                    </VerticalStackLayout>


                                    <!-- STATUS -->
                                    <Border
                                        Grid.Column="2"
                                        Padding="10,5"
                                        VerticalOptions="Start"
                                        BackgroundColor="#243B2E"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 14">

                                        <Label
                                            Text="{Binding Status}"
                                            TextColor="#72D59B"
                                            FontSize="12"
                                            FontAttributes="Bold" />

                                    </Border>

                                </Grid>

                            </Border>

                        </DataTemplate>

                    </CollectionView.ItemTemplate>

                </CollectionView>


                <Button
                    Text="Mark Selected as Returned"
                    Clicked="OnMarkReturnedClicked"
                    BackgroundColor="#5930DB"
                    TextColor="White"
                    FontAttributes="Bold"
                    HeightRequest="48"
                    CornerRadius="10" />

            </VerticalStackLayout>


            <!-- RETURNED ITEMS -->
            <VerticalStackLayout
                Spacing="12"
                Margin="0,14,0,30">

                <VerticalStackLayout Spacing="2">

                    <Label
                        Text="Returned Items"
                        FontSize="24"
                        FontAttributes="Bold"
                        TextColor="White" />

                    <Label
                        Text="History of found items that have been returned to their owners."
                        FontSize="14"
                        TextColor="#A9A9B2" />

                </VerticalStackLayout>


                <CollectionView
                    x:Name="ReturnedReportsView"
                    MinimumHeightRequest="180">

                    <CollectionView.EmptyView>

                        <Border
                            Padding="22"
                            BackgroundColor="#1D1D21"
                            Stroke="#33333A"
                            StrokeShape="RoundRectangle 14">

                            <Label
                                Text="No items have been returned yet."
                                TextColor="#A9A9B2"
                                HorizontalOptions="Center" />

                        </Border>

                    </CollectionView.EmptyView>


                    <CollectionView.ItemTemplate>

                        <DataTemplate>

                            <Border
                                Margin="0,5"
                                Padding="18"
                                BackgroundColor="#1D1D21"
                                Stroke="#33333A"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 14">

                                <Grid
                                    ColumnDefinitions="*,Auto"
                                    ColumnSpacing="16">

                                    <VerticalStackLayout
                                        Grid.Column="0"
                                        Spacing="4">

                                        <Label
                                            Text="{Binding Name}"
                                            FontSize="18"
                                            FontAttributes="Bold"
                                            TextColor="White" />

                                        <Label
                                            Text="{Binding Category}"
                                            TextColor="#C6C6CE" />

                                        <Label
                                            Text="{Binding Location, StringFormat='Found at: {0}'}"
                                            TextColor="#A9A9B2" />

                                        <Label
                                            Text="{Binding StorageLocation, StringFormat='Stored at: {0}'}"
                                            TextColor="#A9A9B2" />

                                        <Label
                                            Text="{Binding ReturnedAt, StringFormat='Returned: {0:dd MMM yyyy HH:mm}'}"
                                            TextColor="#A9A9B2" />

                                    </VerticalStackLayout>


                                    <Border
                                        Grid.Column="1"
                                        Padding="10,5"
                                        VerticalOptions="Start"
                                        BackgroundColor="#243747"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 14">

                                        <Label
                                            Text="RETURNED"
                                            FontSize="12"
                                            FontAttributes="Bold"
                                            TextColor="#71B7FF" />

                                    </Border>

                                </Grid>

                            </Border>

                        </DataTemplate>

                    </CollectionView.ItemTemplate>

                </CollectionView>

            </VerticalStackLayout>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>