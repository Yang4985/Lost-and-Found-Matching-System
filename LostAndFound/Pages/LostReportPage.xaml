<?xml version="1.0" encoding="utf-8" ?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             x:Class="LostAndFound.Pages.LostReportPage"
             Title="Lost Reports"
             BackgroundColor="#151517">

    <ScrollView>

        <VerticalStackLayout
            Padding="32"
            Spacing="24"
            MaximumWidthRequest="1000"
            HorizontalOptions="Fill">

            <!-- PAGE HEADER -->
            <VerticalStackLayout Spacing="5">

                <Label
                    Text="Report a Lost Item"
                    FontSize="32"
                    FontAttributes="Bold"
                    TextColor="#B69CFF" />

                <Label
                    Text="Provide as much information as possible to help campus staff identify potential matches."
                    FontSize="15"
                    TextColor="#A9A9B2" />

            </VerticalStackLayout>


            <!-- INFORMATION BANNER -->
            <Border
                Padding="16"
                BackgroundColor="#211E2C"
                Stroke="#463A68"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 12">

                <Grid ColumnDefinitions="Auto,*"
                      ColumnSpacing="12">

                    <Label
                        Grid.Column="0"
                        Text="ⓘ"
                        FontSize="20"
                        TextColor="#B69CFF"
                        VerticalOptions="Center" />

                    <Label
                        Grid.Column="1"
                        Text="Fields marked with * are required. Include identifying details that may help staff verify ownership."
                        FontSize="14"
                        TextColor="#D0C8E8"
                        VerticalOptions="Center" />

                </Grid>

            </Border>


            <!-- LOST ITEM FORM -->
            <Border
                Padding="24"
                BackgroundColor="#1D1D21"
                Stroke="#33333A"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 16">

                <VerticalStackLayout Spacing="18">

                    <Label
                        Text="Lost Item Details"
                        FontSize="21"
                        FontAttributes="Bold"
                        TextColor="White" />


                    <!-- ITEM NAME -->
                    <VerticalStackLayout Spacing="6">

                        <Label
                            Text="Item Name *"
                            FontSize="13"
                            FontAttributes="Bold"
                            TextColor="#D8D8DD" />

                        <Entry
                            x:Name="ItemNameEntry"
                            Placeholder="e.g. Samsung Phone"
                            PlaceholderColor="#777780"
                            TextColor="White"
                            BackgroundColor="#26262B" />

                    </VerticalStackLayout>


                    <!-- CATEGORY -->
                    <VerticalStackLayout Spacing="6">

                        <Label
                            Text="Category *"
                            FontSize="13"
                            FontAttributes="Bold"
                            TextColor="#D8D8DD" />

                        <Picker
                            x:Name="CategoryPicker"
                            Title="Select category"
                            TitleColor="#777780"
                            TextColor="White"
                            BackgroundColor="#26262B" />

                    </VerticalStackLayout>


                    <!-- BRAND / COLOUR -->
                    <Grid
                        ColumnDefinitions="*,*"
                        ColumnSpacing="16">

                        <VerticalStackLayout
                            Grid.Column="0"
                            Spacing="6">

                            <Label
                                Text="Brand"
                                FontSize="13"
                                FontAttributes="Bold"
                                TextColor="#D8D8DD" />

                            <Entry
                                x:Name="BrandEntry"
                                Placeholder="Optional"
                                PlaceholderColor="#777780"
                                TextColor="White"
                                BackgroundColor="#26262B" />

                        </VerticalStackLayout>


                        <VerticalStackLayout
                            Grid.Column="1"
                            Spacing="6">

                            <Label
                                Text="Colour"
                                FontSize="13"
                                FontAttributes="Bold"
                                TextColor="#D8D8DD" />

                            <Entry
                                x:Name="ColourEntry"
                                Placeholder="Optional"
                                PlaceholderColor="#777780"
                                TextColor="White"
                                BackgroundColor="#26262B" />

                        </VerticalStackLayout>

                    </Grid>


                    <!-- LOCATION -->
                    <VerticalStackLayout Spacing="6">

                        <Label
                            Text="Location Lost *"
                            FontSize="13"
                            FontAttributes="Bold"
                            TextColor="#D8D8DD" />

                        <Entry
                            x:Name="LocationEntry"
                            Placeholder="e.g. WG Building Level 4"
                            PlaceholderColor="#777780"
                            TextColor="White"
                            BackgroundColor="#26262B" />

                    </VerticalStackLayout>


                    <!-- DATE -->
                    <VerticalStackLayout Spacing="6">

                        <Label
                            Text="Date Lost *"
                            FontSize="13"
                            FontAttributes="Bold"
                            TextColor="#D8D8DD" />

                        <DatePicker
                            x:Name="LostDatePicker"
                            MaximumDate="{x:Static sys:DateTime.Today}"
                            TextColor="White"
                            BackgroundColor="#26262B" />

                    </VerticalStackLayout>


                    <!-- DESCRIPTION -->
                    <VerticalStackLayout Spacing="6">

                        <Label
                            Text="Description *"
                            FontSize="13"
                            FontAttributes="Bold"
                            TextColor="#D8D8DD" />

                        <Editor
                            x:Name="DescriptionEditor"
                            Placeholder="Describe the item and anything staff should know."
                            PlaceholderColor="#777780"
                            TextColor="White"
                            BackgroundColor="#26262B"
                            AutoSize="TextChanges"
                            MinimumHeightRequest="100" />

                    </VerticalStackLayout>


                    <!-- DISTINGUISHING FEATURES -->
                    <VerticalStackLayout Spacing="6">

                        <Label
                            Text="Distinguishing Features"
                            FontSize="13"
                            FontAttributes="Bold"
                            TextColor="#D8D8DD" />

                        <Entry
                            x:Name="FeaturesEntry"
                            Placeholder="e.g. cracked corner, sticker, engraving"
                            PlaceholderColor="#777780"
                            TextColor="White"
                            BackgroundColor="#26262B" />

                    </VerticalStackLayout>


                    <!-- VALIDATION MESSAGE -->
                    <Label
                        x:Name="ValidationLabel"
                        TextColor="#FF7777"
                        FontAttributes="Bold"
                        IsVisible="False" />


                    <!-- SAVE BUTTON -->
                    <Button
                        Text="Submit Lost Item Report"
                        Clicked="OnSaveClicked"
                        BackgroundColor="#5930DB"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="10"
                        HeightRequest="50"
                        Margin="0,6,0,0" />

                </VerticalStackLayout>

            </Border>


            <!-- SUBMITTED REPORTS -->
            <VerticalStackLayout
                Spacing="12"
                Margin="0,8,0,0">

                <VerticalStackLayout Spacing="3">

                    <Label
                        Text="Submitted Lost Reports"
                        FontSize="24"
                        FontAttributes="Bold"
                        TextColor="White" />

                    <Label
                        Text="Lost-item reports currently recorded in the system."
                        FontSize="14"
                        TextColor="#A9A9B2" />

                </VerticalStackLayout>


                <CollectionView
                    x:Name="ReportsView"
                    MinimumHeightRequest="280">

                    <CollectionView.EmptyView>

                        <Border
                            Padding="28"
                            Margin="0,8"
                            BackgroundColor="#1D1D21"
                            Stroke="#33333A"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 14">

                            <Label
                                Text="No lost reports have been submitted."
                                HorizontalOptions="Center"
                                TextColor="#A9A9B2" />

                        </Border>

                    </CollectionView.EmptyView>


                    <CollectionView.ItemTemplate>

                        <DataTemplate>

                            <Border
                                Padding="18"
                                Margin="0,6"
                                BackgroundColor="#1D1D21"
                                Stroke="#33333A"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 14">

                                <Grid
                                    ColumnDefinitions="*,Auto"
                                    ColumnSpacing="18">

                                    <!-- REPORT DETAILS -->
                                    <VerticalStackLayout
                                        Grid.Column="0"
                                        Spacing="5">

                                        <Label
                                            Text="{Binding Name}"
                                            FontAttributes="Bold"
                                            FontSize="19"
                                            TextColor="White" />

                                        <Label
                                            Text="{Binding Category, StringFormat='Category: {0}'}"
                                            FontSize="14"
                                            TextColor="#C6C6CE" />

                                        <Label
                                            Text="{Binding Location, StringFormat='Lost at: {0}'}"
                                            FontSize="14"
                                            TextColor="#A9A9B2" />

                                        <Label
                                            Text="{Binding DateLost, StringFormat='Date lost: {0:dd MMM yyyy}'}"
                                            FontSize="14"
                                            TextColor="#A9A9B2" />

                                    </VerticalStackLayout>


                                    <!-- STATUS -->
                                    <Border
                                        Grid.Column="1"
                                        Padding="12,6"
                                        VerticalOptions="Start"
                                        BackgroundColor="#2C244A"
                                        Stroke="#6247A9"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 14">

                                        <Label
                                            Text="{Binding Status}"
                                            FontSize="12"
                                            FontAttributes="Bold"
                                            TextColor="#C6B4FF" />

                                    </Border>

                                </Grid>

                            </Border>

                        </DataTemplate>

                    </CollectionView.ItemTemplate>

                </CollectionView>

            </VerticalStackLayout>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>